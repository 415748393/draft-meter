{
  "name": "@local/draft-meter",
  "version": "1.0.0",
  "private": true,
  "description": "Shows the character and estimated token weight of the message you are writing, below the composer.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "composer",
    "token-count"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
